RES_CONS_PRIMAL(June)..  2*X(Hay) + X(Grain) =L= 14000 ; (LHS = 15)
     
RES_CONS_PRIMAL(July)..  X(Hay) + 2*X(Grain) =L= 18000 ; (LHS = 15)
     
RES_CONS_PRIMAL(August)..  X(Hay) =L= 6000 ; (LHS = 5)
     
