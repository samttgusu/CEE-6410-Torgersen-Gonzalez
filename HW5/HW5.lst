C o m p i l a t i o n


      Reservoir Design and Irrigation Supply Problem
      Formulated based on Problem 7.4 (Figure 7.3 & Table 7.5)
      Pure Scalar Version - No sets, indices, or array mappings.
   6   
   7  * 1. DEFINE ALL SCALAR VARIABLES
   8  VARIABLES
   9     v_profit           Total annual net profit ($);
  10   
  11  POSITIVE VARIABLES
  12     v_acres            Acres irrigated (continuous)
  13     v_storage1         Storage in reservoir at end of Season 1 (acft)
  14     v_storage2         Storage in reservoir at end of Season 2 (acft)
  15     v_release1         Gravity release to farm in Season 1 (acft)
  16     v_release2         Gravity release to farm in Season 2 (acft)
  17     v_spill1           Spill from reservoir downstream in Season 1 (acft)
  18     v_spill2           Spill from reservoir downstream in Season 2 (acft)
  19     v_pumped1          Water pumped from river to farm in Season 1 (acft)
  20     v_pumped2          Water pumped from river to farm in Season 2 (acft);
  21   
  22  BINARY VARIABLES
  23     v_build_high       1 if high dam (700 acft) is built else 0
  24     v_build_low        1 if low dam (300 acft) is built else 0
  25     v_build_pump       1 if pump station is built else 0;
  26   
  27  * 2. DECLARE EQUATIONS
  28  EQUATIONS
  29     EQ_OBJ             "Objective function to maximize net profit"
  30     EQ_DAM_MUTEX       "Ensure only one dam size can be selected"
  31     EQ_WATER_BAL_1     "Reservoir mass balance for Season 1"
  32     EQ_WATER_BAL_2     "Reservoir mass balance for Season 2"
  33     EQ_CAP_STORAGE_1   "Reservoir storage capacity limit for Season 1"
  34     EQ_CAP_STORAGE_2   "Reservoir storage capacity limit for Season 2"
  35     EQ_CAP_PUMP_1      "Pump capacity limit for Season 1 (2.2 acft/day * 182.5 days)"
  36     EQ_CAP_PUMP_2      "Pump capacity limit for Season 2 (2.2 acft/day * 182.5 days)"
  37     EQ_PUMP_AVAIL_1    "Water available to pump in Season 1 (Spill + 2.0 acft/day * 182.5 days)"
  38     EQ_PUMP_AVAIL_2    "Water available to pump in Season 2 (Spill + 2.0 acft/day * 182.5 days)"
  39     EQ_DEMAND_BAL_1    "Meet irrigation demand for Season 1 (1.0 acft/acre)"
  40     EQ_DEMAND_BAL_2    "Meet irrigation demand for Season 2 (3.0 acft/acre)";
  41   
  42  * 3. EQUATION DEFINITIONS
  43  * Objective: 300*Acres - Capital Costs - 20*Pumping
  44  EQ_OBJ..
  45     v_profit =E= (300 * v_acres)
  46                  - (10000 * v_build_high + 6000 * v_build_low)
  47                  - (8000 * v_build_pump)
  48                  - (20 * v_pumped1)
  49                  - (20 * v_pumped2);
  50   
  51  * Dam Selection (High, Low, or None)
  52  EQ_DAM_MUTEX..
  53     v_build_high + v_build_low =L= 1;
  54   
  55  * Reservoir Balances (Inflow S1 = 600, S2 = 200)
  56  EQ_WATER_BAL_1..
  57     v_storage1 =E= v_storage2 + 600 - v_release1 - v_spill1;
  58   
  59  EQ_WATER_BAL_2..
  60     v_storage2 =E= v_storage1 + 200 - v_release2 - v_spill2;
  61   
  62  * Storage Capacity Limits
  63  EQ_CAP_STORAGE_1..
  64     v_storage1 =L= 700 * v_build_high + 300 * v_build_low;
  65   
  66  EQ_CAP_STORAGE_2..
  67     v_storage2 =L= 700 * v_build_high + 300 * v_build_low;
  68   
  69  * Pump Mechanical Limits: 2.2 acft/day * 182.5 days = 401.5 acft
  70  EQ_CAP_PUMP_1..
  71     v_pumped1 =L= 401.5 * v_build_pump;
  72   
  73  EQ_CAP_PUMP_2..
  74     v_pumped2 =L= 401.5 * v_build_pump;
  75   
  76  * Pump Water Supply Limits: Spill + (2.0 acft/day * 182.5 days = 365 acft)
  77  EQ_PUMP_AVAIL_1..
  78     v_pumped1 =L= v_spill1 + 365.0;
  79   
  80  EQ_PUMP_AVAIL_2..
  81     v_pumped2 =L= v_spill2 + 365.0;
  82   
  83  * Demand Balance Constraints (Pure scalar multiplication)
  84  EQ_DEMAND_BAL_1..
  85     v_release1 + v_pumped1 =E= 1.0 * v_acres;
  86   
  87  EQ_DEMAND_BAL_2..
  88     v_release2 + v_pumped2 =E= 3.0 * v_acres;
  89   
  90  * 4. DEFINE AND SOLVE THE MODEL
  91  MODEL RESERVOIR /ALL/;
  92   
  93  SOLVE RESERVOIR MAXIMIZING v_profit USING MIP;
  94   
  95  * 5. LOG THE FINAL RESULTS
  96  DISPLAY v_profit.L, v_acres.L, v_build_high.L, v_build_low.L, v_build_pump.L, v_storage1.L, v_storage2.L, v_release1.L, v_release2.L, v_pumped1.L, v_pumped2.L, v_spill1.L, v_spill2.L;


