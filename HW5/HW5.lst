---- EQ_PUMP_AVAIL_2  =L=  Water available to pump in Season 2 (Spill + 2.0 acft/day * 182.5 days)

EQ_PUMP_AVAIL_2..  - v_spill2 + v_pumped2 =L= 365 ; (LHS = 0)
     

---- EQ_DEMAND_BAL_1  =E=  Meet irrigation demand for Season 1 (1.0 acft/acre)

EQ_DEMAND_BAL_1..  - v_acres + v_release1 + v_pumped1 =E= 0 ; (LHS = 0)
     

---- EQ_DEMAND_BAL_2  =E=  Meet irrigation demand for Season 2 (3.0 acft/acre)

EQ_DEMAND_BAL_2..  - 3*v_acres + v_release2 + v_pumped2 =E= 0 ; (LHS = 0)
     
